{
  "name": "misidetag-tauri-ts",
  "private": true,
  "version": "2.1.0",
  "description": "MiSideTag desktop lyrics matcher built with Tauri, React and TypeScript",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "pnpm check:version && tsc -b",
    "check:version": "node scripts/check-versions.mjs",
    "build:web": "pnpm check:version && tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "qrc-decoder": "^1.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
